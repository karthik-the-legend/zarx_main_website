{
  "hosting": {
    "predeploy": [
      "node scripts/guard-production.mjs"
    ],
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/investors{,/**}",
        "destination": "/partners/",
        "type": 301
      },
      {
        "source": "/leadership{,/**}",
        "destination": "/why-zarx/",
        "type": 301
      },
      {
        "source": "/services{,/}",
        "destination": "/solutions/",
        "type": 301
      },
      {
        "source": "/services/web-platforms{,/**}",
        "destination": "/services/technology-consultancy/web-platforms/",
        "type": 301
      },
      {
        "source": "/services/mobile-gaming{,/**}",
        "destination": "/services/technology-consultancy/mobile-gaming/",
        "type": 301
      },
      {
        "source": "/services/web3{,/**}",
        "destination": "/services/technology-consultancy/web3/",
        "type": 301
      },
      {
        "source": "/services/ai-automation{,/**}",
        "destination": "/services/technology-consultancy/ai-automation/",
        "type": 301
      },
      {
        "source": "/services/ui-ux-design{,/**}",
        "destination": "/services/technology-consultancy/ui-ux-design/",
        "type": 301
      },
      {
        "source": "/services/animation{,/**}",
        "destination": "/services/technology-consultancy/animation/",
        "type": 301
      },
      {
        "source": "/solutions/web-platforms{,/**}",
        "destination": "/services/technology-consultancy/web-platforms/",
        "type": 301
      },
      {
        "source": "/solutions/mobile-gaming-apps{,/**}",
        "destination": "/services/technology-consultancy/mobile-gaming/",
        "type": 301
      },
      {
        "source": "/solutions/web3{,/**}",
        "destination": "/services/technology-consultancy/web3/",
        "type": 301
      },
      {
        "source": "/solutions/ai-automation{,/**}",
        "destination": "/services/technology-consultancy/ai-automation/",
        "type": 301
      },
      {
        "source": "/solutions/ui-ux-design{,/**}",
        "destination": "/services/technology-consultancy/ui-ux-design/",
        "type": 301
      },
      {
        "source": "/solutions/animation-visual-systems{,/**}",
        "destination": "/services/technology-consultancy/animation/",
        "type": 301
      }
    ],
    "headers": [
      {
        "regex": "^(.*/|.*\\.(html|txt|xml))$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate, s-maxage=86400"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}

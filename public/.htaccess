# Hostinger (LiteSpeed/Apache) settings for the static export in ./out.
# Next.js copies this file from public/ to the root of the upload.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# One canonical address: https://zarxtechnologies.com (no www, always HTTPS).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://zarxtechnologies.com%{REQUEST_URI} [L,R=301]

# Old addresses from the first version of the site.
RewriteRule ^investors/?$ https://zarxtechnologies.com/partners/ [L,R=301]
RewriteRule ^solutions/web-platforms/?$ https://zarxtechnologies.com/services/web-platforms/ [L,R=301]
RewriteRule ^solutions/mobile-gaming-apps/?$ https://zarxtechnologies.com/services/mobile-gaming/ [L,R=301]
RewriteRule ^solutions/web3/?$ https://zarxtechnologies.com/services/web3/ [L,R=301]
RewriteRule ^solutions/ai-automation/?$ https://zarxtechnologies.com/services/ai-automation/ [L,R=301]
RewriteRule ^solutions/ui-ux-design/?$ https://zarxtechnologies.com/services/ui-ux-design/ [L,R=301]
RewriteRule ^solutions/animation-visual-systems/?$ https://zarxtechnologies.com/services/animation/ [L,R=301]

# Pages are folders (e.g. /solutions/index.html); add the trailing slash.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://zarxtechnologies.com/$1/ [L,R=301]

ErrorDocument 404 /404.html

# Hashed build assets never change, so browsers can cache them for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
